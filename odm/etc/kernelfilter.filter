	"other"
	{
		conditions = ["dmesg_end"];
		cline = [-10,0];
		"shutdown_crash systemserver"
		{
			conditions = ["oppo_shutdown_detect", "current phase systemserver"];
			fline = [-3000,0];
			cline = [0,0];
			group = "BSP";
		}
		"shutdown_crash init"
		{
			conditions = ["oppo_shutdown_detect", "current phase init"];
			fline = [-3000,0];
			cline = [0,0];
			group = "BSP";
		}
		"Suspend"
		{
			conditions = ["suspend ns"];
			fline = [-5,0];
			cline = [0,0];
			group = "BSP";
		}
	}

	"reboot"
	{
		conditions = ["reboot_log_begin"];
		fline = [0,5000];
		"%s,($0$)"
		{
			conditions = ["bootup critical service "];
			fline = [0,5000];
			cline = [0,0];
			group = "Android";
			reason = "reboot";
		}
		"%s,($0$)"
		{
			conditions = ["OCP Occured: "];
			fline = [0,5000];
			cline = [0,0];
			group = "BSP";
			reason = "hw";
		}
		"lowLevelShutdown"
		{
			conditions = ["PowerManagerService: lowLevelShutdown, reason=battery"];
			fline = [0,5000];
			cline = [0,0];
			group = "BSP";
			reason = "charger";
		}
		"lowLevelShutdown"
		{
			conditions = ["POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL, should shutdown"];
			fline = [0,5000];
			cline = [0,0];
			group = "BSP";
			reason = "charger";
		}
		"%s,($0$)"
		{
			conditions = ["GP_FAULT"];
			fline = [0,500000];
			cline = [0,0];
			group = "BSP";
			reason = "hw";
		}
	}
