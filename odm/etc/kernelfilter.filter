	"Initiative Panic"
	{
		conditions = ["Kernel panic - not syncing"];
		"Subsystem Fatal Error" {
			"modem"{
				"Powerup error"{
					conditions =  ["Powerup error: modem!"];
					reason = "modem";
				}
				"modem crashed"
				{
					conditions =  ["Subsystem modem crashed during SSR"];
					reason = "modem";
