	"kernel(OCP_REBOOT)"
	{
		conditions = ["Exception Class: OCP reboot"];
		fline = [1,100];
		cline = [0,100];
		group = "BSP";
		reason = "OCP";
	}
	"QCOM_OCP_REBOOT"
	{
		conditions = ["PM: OCP Occured: PMIC:"];
		fline = [1,10000];
		cline = [0,100];
		group = "BSP";
		reason = "OCP";
	}
	"kernel(HWT)"
	{
		conditions = ["Exception Class: HWT"];
		fline = [1,100];
		cline = [0,100];
		group = "BSP";
		reason = "HWT";
	}
	"HW-reboot"
	{
		conditions = ["Exception Class: Hardware Reboot"];
		fline = [-1000,1000];
		cline = [-100,1000];
		"%s,($1$)"
		{
			conditions = ["HW reboot Analysis>","Type>"];
			fline = [-100,100];
			"%s,($0$)"
			{
				conditions = ["illegal address"];
				fline = [-5,5];
				group = "BSP";
				reason = "HW-reboot";
			}
		}
		"%s,($0$)"
		{
			conditions = ["HW reboot, check"];
			cline = [-100,100];
			fline = [-100,100];
			group = "BSP";
			reason = "hw?";
		}
		"%s,($0$)"
		{
			conditions = ["Detail   :"];
			cline = [-100,100];
			fline = [-100,100];
			group = "BSP";
			reason = "HW-reboot";
		}
	}
	"HW-Reboot"
	{
		conditions = ["Exception Class: Hardware Reboot"];
		fline = [-100,100];
		group = "BSP";
		reason = "HW-Reboot";
	}
	"HANG_DETECT"
	{
		conditions = ["Exception Class: HANG_DETECT"];
		fline = [-10000,10000];
		cline = [-10000,10000];
		"SS_reboot"
		{
			conditions = ["hang_detect thread counts down -1:11"];
			fline = [-10000,50000];
			group = "Android";
			reason = "WDT";
		}
		"SS_dump"
		{
			conditions = ["hang_detect thread counts down -1:12"];
			fline = [-10000,50000];
			group = "BSP";
			reason = "WDT";
		}
		"SS_run"
		{
