					reason = "modem";
				}
				"Timed out"{
					conditions = ["Timed out waiting for error ready: modem!"];
					reason = "modem";
				}
			}
			"wcnss"{
				"Powerup error"{
					conditions = ["Powerup error: wcnss!"];
					reason = "wcnss";
				}
				"Subsystem crashed"
				{
					conditions = ["Subsystem wcnss crashed during SSR"];
					reason = "wcnss";
				}
				"Timed out"{
					conditions = ["Timed out waiting for error ready: wcnss!"];
					reason = "wcnss";
				}
			}
			"cdsp"{
				"Subsystem crashed"
				{
					conditions = ["remoteproc-cdsp"];
					reason = "cdsp";
				}
			}
			"slpi"{
				"Subsystem crashed"
				{
					conditions = ["remoteproc-slpi"];
					reason = "slpi";
				}
			}
			"adsp"{
				"adsp"{
					conditions = ["subsys-restart: subsystem_restart_dev(): Restart sequence requested for adsp"];
					reason = "adsp";
				}
				"Subsystem crashed"{
					conditions = ["Subsystem adsp crashed during SSR"];
					reason = "adsp";
				}
			}
			"adsp crashed"{
				conditions = ["adsp crashed"];
				reason = "adsp";
			}
		}
		"Out of memory"{
			conditions = ["Out of memory and no killable processes..."];
			fline = [-100,10000];
			reason = "Outofmemory";
		}
		"Init Proc Error"{
			conditions = ["kill init"];
			fline = [-20,10000];
			reason = "user";
		}
		"EXT4-fs"
		{
			conditions = ["Kernel panic - not syncing: EXT4-fs (device dm-0): panic forced after error", "Kernel panic - not syncing: EXT4-fs (device mmcblk0p42): panic forced after error"];
			fline = [-100,10000];
			reason = "EXT4-fs";
		}
		"stackCorrupted"
		{
			conditions = ["Kernel panic - not syncing: stack-protector: Kernel stack is corrupted in:"];
			fline = [-100,10000];
			reason = "stackCorrupted";
		}
		"%s,($0$)"
		{
			conditions = ["Kernel panic - not syncing:"];
			fline = [-100,100];
		}
