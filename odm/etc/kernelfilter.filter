#######gyx creat for kernel log filter ######
# name and content can no include # { } "
# [\\\\/:*?\"<>|] can not be use as name all of these characters will be replace as _
# if reason not set will be set as "Uk" means unkown default
# if content is other means anything can match
# sub content must can be found [parent_found_line-10 parent_found_line-10 ]
# if content is null,means just a parent folder
#name content reason

#"a"
{
	"kernel/KE/dm-verity"
	{
		conditions = ["Kernel panic - not syncing: dm-verity device corrupted"];
		fline = [1,100];
		cline = [0,100];
		group = "BSP";
		reason = "dm-verity";
	}
	# mtk known
	"Kernel (KE)"
	{
		conditions = ["Exception Class: Kernel (KE)"];
		#add here
		"k64"{
			conditions = ["k64] fork"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"om.zhiqupk.root"{
			conditions = ["om.zhiqupk.root"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"yumie64"{
			conditions = ["yumie64] fork"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"king user"{
			conditions = ["king user] fork"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"krpr"{
			conditions = ["krpr] fork"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"krs_100193"{
			conditions = ["krs_100193] fork"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"o360.mobilesafe"{
			conditions = ["o360.mobilesafe] fork"];
			fline = [-10000,10000];
			group = "Android";
			reason = "has_root";
		}
		"tewilovesyouyet"{
			conditions = ["tewilovesyouyet"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "virus";
		}
		"RT throttling0103"{
			conditions = ["aee_wdt_atf_info","sched: RT throttling activated cpu=","kick=0x00000001,check=0x00000003"];
			cline = [-10000,10000];
			fline = [-10000,10000];
			group = "Android";
			reason = "RT throttling";
		}
		"RT throttling1030"{
			conditions = ["aee_wdt_atf_info","sched: RT throttling activated cpu=","kick=0x00000010,check=0x00000030"];
			cline = [-10000,10000];
			fline = [-10000,10000];
			group = "Android";
			reason = "RT throttling";
		}
		"subsys_if_on"
		{
			conditions = ["PC is at [","subsys_if_on+0x","pm_suspend+0x"];
			cline = [-10000,10000];
			fline = [-10000,10000];
			group = "BSP";
			reason = "subsys clk on";
		}
		"wifi them"
		{
			conditions = ["PC is at wmt_cl_set_cur_state+","thermal_cdev_update"];
			fline = [-10000,10000];
			cline = [-10000,10000];
			group = "BSP";
			reason = "hw"; #6625 bad
		}
		"UserCrash"
		{
			conditions = ["PC is at","sysrq_handle_crash"];
			fline = [0,10];
			cline = [0,0];
			group = "Android";
			reason = "user";
		}
		"strnlen"
		{
			conditions = ["PC is at strnlen+"];
			fline = [-10,100];
			group = "BSP";
			reason = "fixed";
		}

		"socket case"
		{
			conditions = ["inet_put_port+","tcp_close+","inet_release+"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "fixed";
		}
		"ged_dvfs"
		{
			conditions = ["__lock_task_sighand+","do_send_sig_info+","ged_dvfs_probe_signal+"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "fixed";
		}
		"Mem frag"
		{
			conditions = ["swiotlb_full+"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "Mem frag";
		}
		"%s,($0$)"
		{
			conditions = ["Bad mode in Synchronous Abort handler detected, code "];
			fline = [-10000,10000];
			group = "BSP";
			reason = "hw";
		}
		"kmem_cache_alloc"
		{
			conditions = ["PC is at","kmem_cache_alloc"];
			fline = [-10,20];
			cline = [0,0];
			group = "BSP";
			reason = "hw";
		}

		"%s,($0$)"
		{
			#http://gerrit.scm.adc.com:8080/#/c/155412/
			conditions = ["arch_reset: cmd = ","mutex_lock","pmic_config_interface"];
			fline = [-10000,10000];
			cline = [-10,10];
			group = "BSP";
			reason = "fixed";
		}

		"pmic6311 voltage abnormal"
		{
			#http://gerrit.scm.adc.com:8080/#/c/143337/
			conditions = ["cur_vproc = 60000"];
			fline = [-10000,10000];
			group = "BSP";
			#http://gerrit.scm.adc.com:8080/#/c/143337/
			reason = "fixed";
		}
		"gpu error"
		{
			conditions = ["mali-renderer]BUG: failure at"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "gpu error";
		}
		"modem error"
		{
			conditions = ["disable_subsys+","md_cd_power_off+"];
			fline = [-10000,10000];
			cline = [-100,100];
			group = "NetWork";
			reason = "modem error";

		}
		"dvfs timeout"
		{
			conditions = ["[CPUHVFS] CLUSTER0 DVFS TIMEOUT"];
			cline = [-500,500];
			fline = [-10000,10000];
			group = "BSP";
			reason = "dvfs timeout";
		}
		"OTG switch"
		{
			conditions = ["xhci_unregister_plat+"];
			cline = [-500,500];
			fline = [-10000,10000];
			group = "BSP";
			reason = "fix OTG swtich";
		}
		"sdcard error"
		{
			conditions = ["msdc1 -> check card state<7> <- msdc_check_write_timeout()"];
			cline = [-500,500];
			fline = [-10000,10000];
			group = "BSP";
			reason = "sdcard error";

		}
		"FAT-fs error"{
			conditions = ["FAT-fs (mmcblk1p1): error, invalid access to FAT (entry"];
			cline = [-10,10];
			fline = [-10000,10000];
			group = "BSP";
			reason = "sdcard error";
		}
		"Wifi DPM timeout"{
			conditions = ["mtk_btif 1100c000.btif: **** DPM device timeout"];
			cline = [-10,10];
			fline = [-10000,10000];
			group = "Connectivity";
			reason = "Wifi DPM timeout";
		}
		"Sdcard DPM timeout"{
			conditions = ["mtk-msdc 11240000.msdc1: **** DPM device timeout"];
			cline = [-10,10];
			fline = [-10000,10000];
			group = "BSP";
			reason = "Sdcard DPM timeout";
		}
		#add here
		"cpu0 wdt"
		{
			conditions = ["kick=0x00000000,check=0x00000001"];
			fline = [0,10000];
			cline = [0,0];
			group = "BSP";
			reason = "cpu0 tick";
		}
		"cpu4 wdt"
		{
			conditions = ["kick=0x00000000,check=0x00000010"];
			fline = [0,10000];
			cline = [0,0];
			group = "BSP";
			reason = "cpu4 tick";
		}
		"cpu%s wdt,($1$$0$)"
		{
			conditions = ["kick=","check="];
			fline = [0,10000];
			cline = [0,0];
			group = "BSP";
			reason = "cpu tick";
		}
		"Hang_Detect"
		{
			conditions = ["[Hang_Detect] we should triger	HWT	"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "Hang_Detect";
		}
		"mmc error"
		{
			conditions = ["msdc_command_resp_polling","msdc0 -> XXX CMD<","msdc_dump_trans_error","[msdc]0000 ["];
			cline = [-10000,10000];
			fline = [-10000,10000];
			group = "BSP";
			reason = "mmc error";
		}
		#wen.luo@BSP.Kernel.stability, 2019/06/24, add begin
		"ipanic"
		{
			conditions = ["PC is at [<","ipanic"];
			fline = [-10000,10000];
			cline = [0,0];
			"Init Proc Error"
			{
				conditions = ["kill init"];
				fline = [-20,10000];
				reason = "user";
			}
			"IO_hung"
			{
				conditions = ["IO blocked too long time"];
				fline = [-10000,20000];
				group = "BSP";
				reason = "hw";
			}
			"by_"
			{
				conditions = ["Backtrace:"];
				fline = [1,10];
				"%s,($0$)"
				{
					conditions = [">] "];
					fline = [1,5];
					group = "BSP";
					reason = "UK";
				}
			}
		}
		"PC is at_%s,($1$)"
		{
			conditions = ["PC is at [<",">] "];
			fline = [-10000,10000];
			cline = [0,0];
			group = "BSP";
			reason = "Uk";
		}
		#add end
		"__arch_copy_from_user"
		{
			conditions = ["__arch_copy_from_user+"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "ring_buffer";
		}
		"vdec_get_fb"
		{
			conditions = ["vdec_get_fb+"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "vdec";
		}
		"ext4_writepage"
		{
			conditions = ["ext4_writepage+"];
			fline = [-10000,10000];
			group = "BSP";
			reason = "ext4";
		}
		"%s,($0$)"
		{
			conditions = ["PC is at"];
			group = "BSP";
			reason = "Uk";
		}
	}
	
	#Bin.Wen@BSP.Kernel.stability, 2021/03/16, add for PMIC Abnormal Status
	"PMIC_Abnormal"
	{
		conditions = ["GCC_RESET_STATUS"];
		"0x42"
		{
			conditions = ["0x42"];
			fline = [-1,1];
			group = "BSP";
			reason = "PMIC";
		}
		"0x42"
		{
			conditions = ["0x43"];
			fline = [-1,1];
			group = "BSP";
			reason = "PMIC";
		}
	}
	"kernel(HWT)"
	{
		conditions = ["Exception Class: HWT"];
		fline = [1,100];
		cline = [0,100];
		"emimpu_violation_irq"
		{
			conditions = ["emimpu_violation_irq"];
			fline = [1,200];
			cline = [0,200];
			group = "BSP";
			reason = "HWT";
		}
	}
	"kernel(HWT)"
	{
		conditions = ["Exception Class: HWT"];
		fline = [1,100];
		cline = [0,100];
		"mtk_vcodec_dec_v2"
		{
			conditions = ["alloc_iova","system_heap.ko","mtk_vcodec_dec_v2.ko"];
			fline = [1,200];
			cline = [0,200];
			group = "BSP";
			reason = "HWT";
		}
	}
	#wen.luo@BSP.Kernel.stability, 2019/06/24, add for HWT HW-reboot
	"Kernel(HWT)"
	{
		conditions = ["Exception Class: HWT"];
		#add here
		"CLK_HANG_RSC_ResetCallback"
		{
			conditions = ["RSC_ResetCallback"];
			fline = [-100,1000];
			group = "CAM";
			reason = "CLK";
		}
		"MD_md_cd_power_off"
		{
			conditions = ["md_cd_power_off"];
			fline = [-100,1000];
			group = "NetWork";
			reason = "modem";
		}
		"L2C_Parity_Error"
		{
			conditions = ["L2C Parity Error"];
			fline = [-100,1000];
			group = "BSP";
			reason = "L2C";
		}
		"CONN_sys_disable_op"
		{
			conditions = ["CONN_sys_disable_op"];
			fline = [-100,1000];
			group = "CNN";
			reason = "CLK";
		}
		"mtk_iommu_TF"
		{
			conditions = ["mtk_iommu: secure mtk_iommu_secure_bk_tf_dump"];
			fline = [-100,10000];
			group = "BSP";
			reason = "IOMMU";
		}
		"CLK_HANG"
		{
			conditions = ["vmlinux  spm_mtcmos_ctrl"];
			fline = [1,100];
			"%s,($0$)"
			{
				conditions = ["vmlinux"];
				fline = [1,5];
				group = "BSP";
				reason = "CLK";
			}
			"%s,($0$)"
			{
				conditions = ["vmlinux"];
				fline = [0,3];
				group = "BSP";
				reason = "CLK";
			}
		}
		"%s,($1$)"
		{
			conditions = ["Interrupt: disable:","vmlinux"];
			fline = [1,100];
			cline = [0,100];
			group = "BSP";
			reason = "HWT";
		}
		"%s,($1$)"
		{
			conditions = ["Detail   :"];
			fline = [1,100];
			cline = [0,100];
			group = "BSP";
			reason = "HWT";
		}
	}
