	"sdi_fail"
	{
		conditions = ["Failed in SDI"];
		cline = [-10,1000];
		group = "BSP";
		reason = "sdi";
	}
	"DDR_Init_Failed"
	{
		conditions = ["DDR Init Failed"];
		cline = [-10,1000];
		group = "BSP";
		reason = "sdi";
	}
	"rpm_err_fatal"
	{
		conditions = ["rpm_log_begin","rpm_err_fatal"];
		cline = [0,1000];
		group = "BSP";
		reason = "rpm_err_fatal";
		"PMIC_%s,($0$)"
		{
			conditions = ["PMIC " ,"Vreg Settling error"];
			fline = [-10,0];
			cline = [0,0];
			group = "BSP";
			reason = "Uk";
		}
		"PMIC_%s,($0$)"
		{
			conditions = ["PMIC " ,"Settling time estimated"];
