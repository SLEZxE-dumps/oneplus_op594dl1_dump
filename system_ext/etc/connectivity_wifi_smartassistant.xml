    <!--
    rule example explain
    <RULE category="A" id="B" result="C"><![CDATA[Expression:D]]></RULE>
        A->category value list: SLA_DUALSTA, SLA_DUPTRX, SMARTASSIST_SLA,
                                 SMARTASSIST_DUPTRX, SMARTASSIST_DUALSTA
        B->id value list: 1 ~ 2147483647(max int), Positive integer
        C->result value list:SLA、DUAL_STA、DUP_TRX、SMART_ASSISTANT
        D->Expression Only the following expression combinations are supported:
        Relational operators: >, <, =, >=, <=, !
        Logical operators: &&, ||
        Parentheses: ()
        Variables: numbers, legal variables starting with $
        * All legal variables are included in the following definitions and cannot be newly added
        * $mAppClass:
        *  ===> DEFAULT->0, SHORT_VIDEO->1, LONG_VIDEO->2, NEWS->3, BROWSER->4, CONVENIENT_LIFE->5, SHOPPING->6, SOCIAL->7, OFFICE->8, DOWNLOAD->9, MUSIC->10, GAME->11;
        * $mScenesMode:
        *  ===> DEFAULT->0, VIDEO->1, DOWNLOAD->2, READING->3, AUDIO_CALL->4, VIDEO_CALL->5, FILE_DOWNLOAD->6, FILE_UPLOAD->7, VIDEO_LIVE->8, GAME->9;
        * $mMoving: ===> DEFAULT->0, ENTER_FENCE->1, LEAVE_FENCE->2, ON_FOOT->3, STILL->4, WALKING->5, RUNNING->6, GO_ELEVATOR->7;
        * $mInGameMode: ===> not in game->0, in game->1;
        * $mIsBtcOnSecSta:  ===> secSta will not introduce btc ->0, secSta will introduce btc -> 1.
        * $mDualStaTriggerSrc, $mSmartAssTriggerSrc, $mSlaTriggerSrc:
        *  ===> signal map trigger->61
        * $mPriL2QoeLevel, $mSecL2QoeLevel, $mPriFinalQoeLevel
        *  ===> value range: 0 ~ 5
        * $mPriRssiLevel ===> primary rssi level:0 ~ 4
    <RULE category="SLA_DUALSTA" id="10" result="x"><![CDATA[expression]]></RULE>
    <RULE category="SLA_DUPTRX" id="10" result="x"><![CDATA[expression]]></RULE>
    <RULE category="SMARTASSIST_SLA" id="10" result="x"><![CDATA[expression]]></RULE>
    <RULE category="SMARTASSIST_DUPTRX" id="10" result="x"><![CDATA[expression]]></RULE>
    <RULE category="SMARTASSIST_DUALSTA" id="10" result="x"><![CDATA[expression]]></RULE>
    -->
    <MULTINETWORK_SCHEDULING_RULES>
        <!-- SLA_DUALSTA -->
        <!-- secondary sta will introduces btc -->
        <RULE category="SLA_DUALSTA" id="10" result="SLA"><![CDATA[($mIsBtcOnSecSta == 1)]]></RULE>
        <!-- non still: like walking, running, Go/Level elevator/fence -->
        <RULE category="SLA_DUALSTA" id="20" result="SLA"><![CDATA[($mMoving != 4) && ($mMoving != 0)]]></RULE>
        <!-- real-time app scence: video/audio call, living, game -->
        <RULE category="SLA_DUALSTA" id="30" result="SLA"><![CDATA[($mScenesMode == 4) || ($mScenesMode == 5) || ($mScenesMode == 8) || ($mScenesMode == 9)]]></RULE>
        <!-- real-time app app: game or office/meeting app -->
        <RULE category="SLA_DUALSTA" id="40" result="SLA"><![CDATA[($mAppClass == 11) || ($mAppClass == 8)]]></RULE>
        <!-- Dual High value: l3 network score jitter, signle white app list stuck -->
        <RULE category="SLA_DUALSTA" id="50" result="DUAL_STA"><![CDATA[($mPriL2QoeLevel >= 4)]]></RULE>
        <!-- non real-time app scence: video/audio call, living, game -->
        <RULE category="SLA_DUALSTA" id="60" result="DUAL_STA"><![CDATA[(($mScenesMode == 1) || ($mScenesMode == 2) || ($mScenesMode == 3) || ($mScenesMode == 6) || ($mScenesMode == 7))]]></RULE>
        <!-- non real-time app app: game or office/meeting app -->
        <RULE category="SLA_DUALSTA" id="70" result="DUAL_STA"><![CDATA[(($mAppClass != 11) && ($mAppClass != 8) && ($mAppClass != 0))]]></RULE>
        <!-- still -->
        <RULE category="SLA_DUALSTA" id="80" result="DUAL_STA"><![CDATA[($mMoving == 4)]]></RULE>
        <!-- trigger source placeholder -->
        <!-- default rule -->
        <RULE category="SLA_DUALSTA" id="90" result="SLA"><![CDATA[($mAppClass >= 0)]]></RULE>

        <!-- SLA_DUPTRX -->
        <!-- secondary sta will introduces btc -->
        <RULE category="SLA_DUPTRX" id="10" result="SLA"><![CDATA[($mIsBtcOnSecSta == 1)]]></RULE>
        <!-- full(4) signal level -->
        <RULE category="SLA_DUPTRX" id="20" result="DUP_TRX"><![CDATA[($mPriRssiLevel >= 4) && ($mSecL2QoeLevel >= 5)]]></RULE>
        <!-- still -->
        <RULE category="SLA_DUPTRX" id="30" result="DUP_TRX"><![CDATA[($mMoving == 4)]]></RULE>
        <!-- both l2 bad: primary and secondary l2 link both poor -->
        <RULE category="SLA_DUPTRX" id="40" result="SLA"><![CDATA[(($mPriL2QoeLevel <= 3) && ($mPriL2QoeLevel > 0)) && (($mSecL2QoeLevel <= 3) && ($mSecL2QoeLevel > 0))]]></RULE>
        <!-- guess router l3 bad: primary rssi and l2 qoe both good -->
        <RULE category="SLA_DUPTRX" id="50" result="SLA"><![CDATA[($mPriL2QoeLevel >= 4) && ($mPriRssiLevel >= 4)]]></RULE>
        <!-- default rule -->
        <RULE category="SLA_DUPTRX" id="60" result="SLA"><![CDATA[($mAppClass >= 0)]]></RULE>

        <!-- SMARTASSIST_DUPTRX -->
        <RULE category="SMARTASSIST_DUPTRX" id="5" result="SMART_ASSISTANT"><![CDATA[($mSmartAssTriggerSrc == 69)]]></RULE>
        <!-- secondary sta will introduces btc -->
        <RULE category="SMARTASSIST_DUPTRX" id="10" result="SMART_ASSISTANT"><![CDATA[($mIsBtcOnSecSta == 1)]]></RULE>
        <!-- full(4) signal level -->
        <RULE category="SMARTASSIST_DUPTRX" id="20" result="DUP_TRX"><![CDATA[($mPriRssiLevel >= 4) && ($mSecL2QoeLevel >= 5)]]></RULE>
        <!-- still -->
        <RULE category="SMARTASSIST_DUPTRX" id="30" result="DUP_TRX"><![CDATA[($mMoving == 4)]]></RULE>
        <!-- both l2 bad: primary and secondary l2 link both poor -->
        <RULE category="SMARTASSIST_DUPTRX" id="40" result="SMART_ASSISTANT"><![CDATA[(($mPriL2QoeLevel <= 3) && ($mPriL2QoeLevel > 0)) && (($mSecL2QoeLevel <= 3) && ($mSecL2QoeLevel > 0))]]></RULE>
        <!-- guess router l3 bad: primary rssi and l2 qoe both good -->
        <RULE category="SMARTASSIST_DUPTRX" id="50" result="SMART_ASSISTANT"><![CDATA[($mPriL2QoeLevel >= 4) && ($mPriRssiLevel >= 4)]]></RULE>
        <!-- default rule -->
        <RULE category="SMARTASSIST_DUPTRX" id="60" result="SMART_ASSISTANT"><![CDATA[($mAppClass >= 0)]]></RULE>

        <!-- SMARTASSIST_DUALSTA -->
        <RULE category="SMARTASSIST_DUALSTA" id="5" result="SMART_ASSISTANT"><![CDATA[($mSmartAssTriggerSrc == 69)]]></RULE>
        <!-- secondary sta will introduces btc -->
        <RULE category="SMARTASSIST_DUALSTA" id="10" result="SMART_ASSISTANT"><![CDATA[($mIsBtcOnSecSta == 1)]]></RULE>
        <!-- non still: like walking, running, Go/Level elevator/fence -->
        <RULE category="SMARTASSIST_DUALSTA" id="20" result="SMART_ASSISTANT"><![CDATA[($mMoving != 4) && ($mMoving != 0)]]></RULE>
        <!-- real-time app scence: video/audio call, living, game -->
        <RULE category="SMARTASSIST_DUALSTA" id="30" result="SMART_ASSISTANT"><![CDATA[($mScenesMode == 4) || ($mScenesMode == 5) || ($mScenesMode == 8) || ($mScenesMode == 9)]]></RULE>
        <!-- real-time app app: game or office/meeting app -->
        <RULE category="SMARTASSIST_DUALSTA" id="40" result="SMART_ASSISTANT"><![CDATA[($mAppClass == 11) || ($mAppClass == 8)]]></RULE>
        <!-- Dual High value: l3 network score jitter, signle white app list stuck -->
        <RULE category="SMARTASSIST_DUALSTA" id="50" result="DUAL_STA"><![CDATA[($mPriL2QoeLevel >= 4)]]></RULE>
        <!-- non real-time app scence: video/audio call, living, game -->
        <RULE category="SMARTASSIST_DUALSTA" id="60" result="DUAL_STA"><![CDATA[(($mScenesMode == 1) || ($mScenesMode == 2) || ($mScenesMode == 3) || ($mScenesMode == 6) || ($mScenesMode == 7))]]></RULE>
        <!-- non real-time app app: game or office/meeting app -->
        <RULE category="SMARTASSIST_DUALSTA" id="70" result="DUAL_STA"><![CDATA[(($mAppClass != 11) && ($mAppClass != 8) && ($mAppClass != 0))]]></RULE>
        <!-- still -->
        <RULE category="SMARTASSIST_DUALSTA" id="80" result="DUAL_STA"><![CDATA[($mMoving == 4)]]></RULE>
        <!-- trigger source placeholder -->
        <!-- default rule -->
        <RULE category="SMARTASSIST_DUALSTA" id="90" result="SMART_ASSISTANT"><![CDATA[($mAppClass >= 0)]]></RULE>

        <!-- SMARTASSIST_SLA -->
        <RULE category="SMARTASSIST_SLA" id="5" result="SMART_ASSISTANT"><![CDATA[($mSmartAssTriggerSrc == 69)]]></RULE>
        <!-- non full(4) signal level -->
        <RULE category="SMARTASSIST_SLA" id="10" result="SMART_ASSISTANT"><![CDATA[($mPriRssiLevel < 4) && ($mPriRssiLevel != 0)]]></RULE>
        <!-- non still state: like walking, running, Go/Level elevator/fence -->
        <RULE category="SMARTASSIST_SLA" id="20" result="SMART_ASSISTANT"><![CDATA[($mMoving != 4) && ($mMoving != 0)]]></RULE>
        <!-- signal map trigger smart assist-->
        <RULE category="SMARTASSIST_SLA" id="30" result="SMART_ASSISTANT"><![CDATA[($mSmartAssTriggerSrc == 61)]]></RULE>
        <RULE category="SMARTASSIST_SLA" id="35" result="SMART_ASSISTANT"><![CDATA[($mAppClass == 8)]]></RULE>
        <!-- SLA High value: l3 network score jitter, signle white app list stuck -->
        <RULE category="SMARTASSIST_SLA" id="40" result="SLA"><![CDATA[($mPriL2QoeLevel >= 4) || ($mInGameMode == 1)]]></RULE>
        <!-- default rule -->
        <RULE category="SMARTASSIST_SLA" id="50" result="SMART_ASSISTANT"><![CDATA[($mAppClass >= 0)]]></RULE>
    </MULTINETWORK_SCHEDULING_RULES>
</smartassistantromupdate>
