			idle-state-name = "pc";
			entry-latency-us = <0xfa>;
			exit-latency-us = <0x384>;
			min-residency-us = <0xc80>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x03>;
