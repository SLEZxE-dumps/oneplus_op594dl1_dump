		ssusb@a600000 {
			compatible = "qcom,dwc-usb3-msm";
			reg = <0xa600000 0x100000>;
			reg-names = "core_base";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			USB3_GDSC-supply = <0x1b0>;
			clocks = <0x27 0x8e 0x27 0x0f 0x27 0x08 0x27 0x90 0x27 0x93>;
			clock-names = "core_clk\0iface_clk\0bus_aggr_clk\0utmi_clk\0sleep_clk";
			resets = <0x27 0x19>;
			reset-names = "core_reset";
			interrupts-extended = <0x01 0x00 0x82 0x04 0x15a 0x0e 0x01 0x15a 0x0f 0x01 0x15a 0x11 0x04>;
			interrupt-names = "pwr_event_irq\0dp_hs_phy_irq\0dm_hs_phy_irq\0ss_phy_irq";
			qcom,use-pdc-interrupts;
			qcom,use-eusb2-phy;
			extcon = <0x1b1>;
			usb-role-switch;
			qcom,dis-sending-cm-l1-quirk;
			qcom,core-clk-rate = <0xbebc200>;
			qcom,core-clk-rate-hs = <0x3f940ab>;
			qcom,core-clk-rate-disconnected = <0x7f28155>;
			qcom,pm-qos-latency = <0x02>;
			qcom,num-gsi-evt-buffs = <0x03>;
			qcom,gsi-reg-offset = <0xfc 0x110 0x120 0x130 0x144 0x1a4>;
			interconnect-names = "usb-ddr\0usb-ipa\0ddr-usb";
			interconnects = <0x159 0x30 0x29 0x200 0x159 0x30 0x13d 0x210 0x28 0x02 0x13d 0x226>;
			phandle = <0x396>;

			dwc3@a600000 {
				compatible = "snps,dwc3";
				reg = <0xa600000 0xd93c>;
				iommus = <0x30 0x80 0x00>;
				qcom,iommu-dma = "atomic";
				qcom,iommu-dma-addr-pool = <0x90000000 0x60000000>;
				dma-coherent;
				interrupts = <0x00 0x85 0x04>;
				usb-phy = <0x1b2 0x1b3>;
				snps,disable-clk-gating;
				snps,has-lpm-erratum;
				snps,hird-threshold = [00];
				snps,is-utmi-l1-suspend;
				snps,usb3_lpm_capable;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				snps,dis_u2_susphy_quirk;
				snps,ssp-u3-u0-quirk;
				tx-fifo-resize;
				dr_mode = "otg";
				maximum-speed = "super-speed-plus";
				usb-role-switch;
			};

			port {

				endpoint {
					remote-endpoint = <0x1b4>;
					phandle = <0x1af>;
				};
			};
		};

		hsphy@88e3000 {
			compatible = "qcom,usb-snps-eusb2-phy";
			reg = <0x88e3000 0x150 0x88e2000 0x04 0xc276000 0x04>;
			reg-names = "eusb2_phy_base\0eud_enable_reg\0eud_detect_reg";
			vdd-supply = <0x12a>;
			qcom,vdd-voltage-level = <0x00 0xd6d80 0xd6d80>;
			vdda12-supply = <0x12b>;
			clocks = <0x149 0x00 0x155 0x04>;
			clock-names = "ref_clk_src\0ref_clk";
			resets = <0x27 0x14>;
			reset-names = "phy_reset";
			qcom,param-override-seq = <0x00 0x58>;
			phandle = <0x1b2>;
		};

		usb_nop_phy {
			compatible = "usb-nop-xceiv";
			phandle = <0x397>;
		};

		ssphy@88e8000 {
			compatible = "qcom,usb-ssphy-qmp-dp-combo";
			reg = <0x88e8000 0x3000>;
			reg-names = "qmp_phy_base";
			vdd-supply = <0x1b5>;
			qcom,vdd-voltage-level = <0x00 0xdea80 0xdea80>;
			qcom,vdd-max-load-uA = <0xb798>;
			core-supply = <0x12b>;
			usb3_dp_phy_gdsc-supply = <0x1b6>;
			clocks = <0x27 0x94 0x27 0x97 0x27 0x98 0x151 0x149 0x00 0x155 0x05 0x27 0x96>;
			clock-names = "aux_clk\0pipe_clk\0pipe_clk_mux\0pipe_clk_ext_src\0ref_clk_src\0ref_clk\0com_aux_clk";
			resets = <0x27 0x1a 0x27 0x1c>;
			reset-names = "global_phy_reset\0phy_reset";
			pinctrl-names = "default";
